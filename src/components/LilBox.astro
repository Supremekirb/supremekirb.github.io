---
const { legend, hgrow, class: className, ...rest } = Astro.props;
---

<fieldset class:list={['lilbox', { hgrow: hgrow }, { [className]: className }]} {...rest}>
    { legend && <legend>{legend}</legend> }
    <slot />
</fieldset>
<style>
.hgrow {
    width: 100%;
    box-sizing: border-box;
}
</style>