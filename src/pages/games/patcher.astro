---
import StandardLayout from "/src/layouts/StandardLayout.astro";
import LilBox from "/src/components/LilBox.astro";
import PatchInfo from "/src/components/PatchInfo.astro";
---
<StandardLayout title="•Play My Video Games, White Child">
    <LilBox hgrow legend="ROM Patcher">
       	<!-- Rom Patcher JS container -->
       	<!--
      		The following elements are required for Rom Patcher JS to work:
     			#rom-patcher-input-file-rom
     			#rom-patcher-select-patch
     			#rom-patcher-button-apply
      		The rest of elements are informative and can be removed, though it's recommended to keep them for a better user experience.
       	-->
        <noscript>This requires JS!</noscript>
        <div class="flex-half-box">
            <div class="flex-half">
               	<div id="rom-patcher-container">
              		<div class="rom-patcher-row margin-bottom" id="rom-patcher-row-file-patch">
             			<div class="text-right"><label for="rom-patcher-input-file-patch" data-localize="yes">Patch:</label>
             			</div>
             			<div class="rom-patcher-container-input">
                				<select id="rom-patcher-select-patch"></select>
             			</div>
              		</div>
                
              		<div class="rom-patcher-row margin-bottom" id="rom-patcher-row-file-rom">
             			<div class="text-right"><label for="rom-patcher-input-file-rom" data-localize="yes">ROM file:</label></div>
             			<div class="rom-patcher-container-input">
                				<input type="file" id="rom-patcher-input-file-rom" class="empty" disabled />
             			</div>
              		</div>
              		<div class="margin-bottom text-selectable text-mono text-muted" id="rom-patcher-rom-info">
             			<div class="rom-patcher-row">
                				<div class="text-right">CRC32:</div>
                				<div class="text-truncate"><span id="rom-patcher-span-crc32"></span></div>
             			</div>
             			<div class="rom-patcher-row" id="rom-patcher-row-info-rom">
                				<div class="text-right">ROM:</div>
                				<div class="text-truncate"><span id="rom-patcher-span-rom-info"></span></div>
             			</div>
              		</div>
              		<div class="rom-patcher-row margin-bottom text-selectable text-mono text-muted"
             			id="rom-patcher-row-patch-requirements">
             			<div class="text-right text-mono" id="rom-patcher-patch-requirements-type">ROM requirements:</div>
             			<div class="text-truncate" id="rom-patcher-patch-requirements-value"></div>
              		</div>
                                
              		<div class="text-center" id="rom-patcher-row-apply">
             			<div id="rom-patcher-row-error-message" class="margin-bottom"><span id="rom-patcher-error-message"></span>
             			</div>
             			<button id="rom-patcher-button-apply" data-localize="yes" disabled>Apply patch</button>
              		</div>
               	</div>
                                
               	<div id="rom-patcher-powered" class="text-center">
              		<a href="https://github.com/marcrobledo/RomPatcher.js" target="_blank"><img
                				src="/games/rom-patcher-js/assets/powered_by_rom_patcher_js.png" loading="lazy" />Powered by Rom Patcher JS</a>
               	</div>
            </div>
            
            <div class="flex-half">
                <PatchInfo id="info-earthground" title="EarthGround" image="/images/earthground.png">
                    <p>
                        Turns EarthBound into a platformer by rewriting the player movement code!
                        You can play the entire game from start to finish.
                        <br>
                        Made in a week for Jank Jam 1.
                        <br>
                        (NOTE: Don't press directions during cutscenes.)
                    </p>
                </PatchInfo>
                <PatchInfo id="info-trialtower" title="EarthBound Trial Tower" image="/images/ebtrialtower.png">
                    <p>
                        A hack that turns the game into a roguelike! Choose a character and scale the Monotoli Building,
                        fighting 100 back-to-back battles, while choosing upgrades and perks to
                        make your team stronger. Also features high-score recording.
                        <br>
                        Made in a couple weeks for Jank Jam 2.
                    </p>
                </PatchInfo>
                <PatchInfo id="info-ticketmaster" title="TicketMaster" image="/images/ticketmaster.png">
                    <p>
                        Battle enemies with new real-time action commands in order to win the Starstruck Sweepstakes!
                        Spend tickets to get gear, items, and special moves, and fight a few secret bosses along the way.
                        <br>
                        Made with Chalkmuncher in a couple weeks for Jank Jam 3.
                    </p>
                </PatchInfo>
                <PatchInfo id="info-m3prologue" title="MOTHER 3 Prologue Recreation" image="/images/mother3.png">
                    <p>
                        This hack recreates a portion of MOTHER 3's prologue as accurately as possible.
                        There's no music, though.
                        <br>
                        This was made for Starmen.net's MOTHER 3 17th Anniversary Funfest.
                    </p>
                </PatchInfo>
            </div>
        </div>
        <p>
            Bad checksum? Try using the <a href="/tools/rom_inspector">ROM inspector</a>.
        </p>
    </LilBox>
</StandardLayout>
<script type="text/javascript" src="/games/rom-patcher-js/RomPatcher.webapp.js"></script>
<link type="text/css" rel="stylesheet" href="/games/rom-patcher-js/style.css" media="all" />
<script type="text/javascript">
const FILENAMES_TO_ID = {
  "1 earthground_1_0.bps": "earthground",
  "2 ebtrialtower_0_2.bps": "trialtower",
  "3 ticketmaster_1_1.bps": "ticketmaster",
  "4 eb_m3_prologue_0_1.bps": "m3prologue"
}
const IDS_TO_FILENAME = {
  "earthground": "1 earthground_1_0.bps",
  "trialtower": "2 ebtrialtower_0_2.bps",
  "ticketmaster": "3 ticketmaster_1_1.bps",
  "m3prologue": "4 eb_m3_prologue_0_1.bps"
}
window.addEventListener('load', async function(){
    const patcherSettings={
        language: 'en',
        requireValidation: true, /* if true, user won't be able to apply patch if the provided ROM is not valid*/
        allowDropFiles: true, /* if true, it adds basic drag and drop support */
        oninitialize: function (romFile) {
          const patch = new URLSearchParams(window.location.search).get("patch")
          if (patch in IDS_TO_FILENAME) {
            RomPatcherWeb.pickEmbededFile(IDS_TO_FILENAME[patch])
          }
        },
        onloadpatch: function (patchFile, info) {
          for (const el of document.getElementsByClassName("patch-info")) {
            if (el.id === "info-" + FILENAMES_TO_ID[info.file]) {
              el.style.display = "block";
            } else {
              el.style.display = "none"
            }
          }
        }
    };
    RomPatcherWeb.initialize(patcherSettings, {
    file: "/games/patcher/patches.zip",
    patches: [
        {
            file: "1 earthground_1_0.bps",
            name: "EB | EarthGround (v1.0)",
            outputName: "earthground_1_0",
        },
        {
            file: "2 ebtrialtower_0_2.bps",
            name: "EB | EarthBound Trial Tower (v0.2)",
            outputName: "ebtrialtower_0_2",
        },
        {
            file: "3 ticketmaster_1_1.bps",
            name: "EB | Ticketmaster (v1.1)",
            outputName: "ticketmaster_1_1",
            id: "ticketmaster"
        },
        {
            file: "4 eb_m3_prologue_0_1.bps",
            name: "EB | MOTHER 3 Prologue Recreation (v0.1)",
            outputName: "eb_m3_prologue_0_1",
            id: "m3-prologue"
        },
    ]
    });
});
</script>